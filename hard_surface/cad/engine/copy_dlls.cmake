file(GLOB dlls "${SRC}/TK*.dll")
foreach(d ${dlls})
  get_filename_component(n ${d} NAME)
  if(NOT EXISTS "${DST}/${n}" OR "${d}" IS_NEWER_THAN "${DST}/${n}")
    file(COPY ${d} DESTINATION ${DST})
  endif()
endforeach()
# TKDESTEP -> TKXCAF -> TKService imports FreeImage.dll + freetype.dll (never called by cadengine). The conda occt
# package leaves them to separate conda packages; we reuse the copies already shipped in the cadquery-ocp wheel
# (same conda-forge builds, delvewheel-mangled names + their mangled deps), copied under the plain names.
if(DEFINED OCPLIBS AND EXISTS "${OCPLIBS}")
  file(GLOB extra "${OCPLIBS}/*.dll")
  foreach(d ${extra})
    get_filename_component(n ${d} NAME)
    if(n MATCHES "^TK")
      continue()
    endif()
    if(NOT EXISTS "${DST}/${n}")
      file(COPY ${d} DESTINATION ${DST})
    endif()
    if(n MATCHES "^FreeImage-")
      file(COPY_FILE ${d} "${DST}/FreeImage.dll" ONLY_IF_DIFFERENT)
    elseif(n MATCHES "^freetype-")
      file(COPY_FILE ${d} "${DST}/freetype.dll" ONLY_IF_DIFFERENT)
    endif()
  endforeach()
endif()
