      "by": "A",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "value_order",
      "where": "engine",
      "stage": "MID",
      "enforce": "advise",
      "when": "allocate",
      "plain": "every material sorted by OKLab lightness — the value plan, computed instead of eyeballed",
      "by": "A",
      "kind": "style",
      "dept": "surface"
    },
    {
      "id": "contrast_adjacent",
      "where": "engine",
      "stage": "MID",
      "enforce": "advise",
      "when": "allocate",
      "plain": "a part must separate in colour from the thing it SITS ON",
      "by": "A",
      "kind": "style",
      "dept": "surface"
    },
    {
      "id": "part_exists",
      "where": "harness/claims.json",
      "stage": "MID",
      "enforce": "block",
      "when": "verify",
      "plain": "the signature part the brief named must exist",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "part_signature",
      "where": "harness/claims.json",
      "stage": "MID",
      "enforce": "advise",
      "when": "allocate",
      "plain": "how much of the side view the signature part holds",
