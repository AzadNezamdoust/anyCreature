{
  "_": [
    "THE MAP. Every check in the system, in one place, tagged on five axes.",
    "",
    "enforce — block | advise",
    "when    — allocate (decidable before the build) | verify (only after it exists)",
    "by      — A | B | C   (which judgment source runs it)",
    "kind    — legality (a defect; only ever gets stricter) | style (a tunable threshold)",
    "dept    — design | model | surface | rig | animation | process",
    "",
    "stage is a FIELD, not a hard-coded branch: LOW/MID/HIGH are levels of",
    "refinement, not a fixed department order. Any stage may run any department at",
    "its own resolution, and moving a check between stages is a data edit.",
    "",
    "The 18 checks tagged `allocate` are decidable before the build. `harness/fit.py`",
    "applies the arithmetic subset of them (root_containment, proportion, size) from",
    "the numbers the engine already prints, so a build round is spent on the",
    "creature rather than on legality.",
    "",
    "Rule of placement: put a check as early as the thing it measures can exist,",
    "at the coarsest resolution that can still show it."
  ],
  "stages": {
    "LOW": "coarse resolution — the whole creature, big masses",
    "MID": "part resolution — named parts and colour",
    "HIGH": "finishing resolution — rig, clips, shading"
  },
  "checks": [
    {
      "id": "mesh_integrity",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "geometry that is not geometry — degenerate or broken faces",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "root_containment",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "the root bone must sit inside the body",
      "by": "A",
      "kind": "legality",
      "dept": "rig"
    },
    {
      "id": "part_attachment",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "a part must actually be seated on what it claims to attach to",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "touch",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "parts that should touch must touch",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "balance",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "the creature must not fall over",
      "by": "A",
      "kind": "legality",
      "dept": "rig"
    },
    {
      "id": "size",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "built height must land within ±15% of the declared height",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "proportion",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "limb and body proportions inside sane bounds",
      "by": "A",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "limb_clearance",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "limbs must not pass through each other while animating",
      "by": "A",
      "kind": "legality",
      "dept": "animation"
    },
    {
      "id": "anim_integrity",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "the animation clips must be valid and must not tear the mesh",
      "by": "A",
      "kind": "legality",
      "dept": "animation"
    },
    {
      "id": "attack_reach",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "the attack must actually reach out, not mime",
      "by": "A",
      "kind": "style",
      "dept": "animation"
    },
    {
      "id": "gait_direction",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "a planted foot must sweep BACKWARD — a forward sweep is a walk cycle playing in reverse",
      "by": "A",
      "kind": "legality",
      "dept": "animation"
    },
    {
      "id": "root_drive",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "verify",
      "plain": "a lunge must be driven on the skeleton ROOT, not on one of its children",
      "by": "A",
      "kind": "legality",
      "dept": "animation"
    },
    {
      "id": "faceted",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "a body that is all flat facets when it should read as flesh",
      "by": "A",
      "kind": "style",
      "dept": "surface"
    },
    {
      "id": "soft_mass",
      "where": "engine",
      "stage": "any",
      "enforce": "block",
      "when": "allocate",
      "plain": "a volume that cannot break anywhere — the rounded sausage",
      "by": "A",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "mirror_distortion",
      "where": "engine",
      "stage": "any",
      "enforce": "advise",
      "when": "verify",
      "plain": "mirrored twins deformed differently",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "part_overlap",
      "where": "engine",
      "stage": "any",
      "enforce": "advise",
      "when": "verify",
      "plain": "how deeply parts interpenetrate",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "part_seat",
      "where": "engine",
      "stage": "any",
      "enforce": "advise",
      "when": "verify",
      "plain": "how well a part sits on its host surface",
      "by": "A",
      "kind": "legality",
      "dept": "model"
    },
    {
      "id": "brief_slots",
      "where": "harness/brief.py",
      "stage": "LOW",
      "enforce": "block",
      "when": "allocate",
      "plain": "every brief slot a later stage READS must be filled in — presence only, never content",
      "by": "A",
      "kind": "legality",
      "dept": "process"
    },
    {
      "id": "brief_coverage",
      "where": "harness/brief.py",
      "stage": "LOW",
      "enforce": "block",
      "when": "allocate",
      "plain": "the chains the brief NAMED must exist in the r1 spec",
      "by": "A",
      "kind": "legality",
      "dept": "process"
    },
    {
      "id": "poles_apart",
      "where": "harness/brief.py + round.py",
      "stage": "LOW",
      "enforce": "block",
      "when": "verify",
      "plain": "the two versions in a round must be opposite ends of one axis, not one design built twice",
      "by": "A",
      "kind": "style",
      "dept": "process"
    },
    {
      "id": "pole_fill",
      "where": "harness/brief.py + round.py",
      "stage": "LOW",
      "enforce": "advise",
      "when": "verify",
      "plain": "a pole that fills too much of its own bounding box is a blob, not a pose",
      "by": "A",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "gate1_recognised",
      "where": "card 01",
      "stage": "LOW",
      "enforce": "block",
      "when": "verify",
      "plain": "a reader who knows nothing must rank the brief's creature high enough, in enough views (harness/identity.py)",
      "by": "B",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "gate2_punchier",
      "where": "card 01",
      "stage": "LOW",
      "enforce": "block",
      "when": "verify",
      "plain": "the exaggerated silhouette must beat the previous round's",
      "by": "B",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "thinnest_px48",
      "where": "harness/maskmetrics.py + roundcheck.py",
      "stage": "LOW",
      "enforce": "advise",
      "when": "allocate",
      "plain": "the width of the thinnest feature on the 48px thumbnail the reader sees",
      "by": "A",
      "kind": "style",
      "dept": "model"
    },
    {
      "id": "tri_budget",
      "where": "harness/claims.json",
      "stage": "LOW",
      "enforce": "advise",
      "when": "allocate",
